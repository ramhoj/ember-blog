<li data-test-comment>
  <div>
    {{#if this.isEditing}}
      <label>
        <span class="sr-only">Comment body</span>
        <CommentForm @onSave={{this.update}} @comment={{@comment}} />
      </label>
      <button type="button" class="btn-secondary" {{on "click" this.cancelEdit}}>Cancel</button>
    {{else}}
      <p class="text-sm" data-test-comment-body>{{@comment.body}}</p>
    {{/if}}

    {{#unless this.isEditing}}
      <div class="flex justify-between text-xs text-slate-500">
        <button type="button" class="btn-link" {{on "click" this.edit}} data-test-edit-comment-button>Edit</button>
        <small>{{format-date @comment.createdAt}}</small>
      </div>
    {{/unless}}
  </div>
</li>