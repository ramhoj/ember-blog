{{page-title "Posts"}}

<div class="flex items-center justify-between mb-6">
  <h1 class="text-3xl font-bold tracking-tight">Posts</h1>
  <LinkTo @route="post-new" class="btn-primary">New Post</LinkTo>
</div>

<div class="mb-4 flex items-center justify-between">
  <button
    {{on "click" (fn (perform this.searchTask) (hash target=(hash value="")))}}
    type="button"
    class="btn-secondary ml-2"
    data-test-clear-search
  >
    Clear
  </button>

  <input
    type="search"
    name="q"
    {{on "input" (perform this.searchTask)}}
    value={{this.q}}
    placeholder="Search posts…"
    aria-label="Search posts"
    class="input"
  >

  {{#if this.searchTask.isRunning}}
    <span class="ml-3 text-sm muted animate-pulse" role="status" aria-live="polite">
      Searching…
    </span>
  {{/if}}
</div>

{{#if this.posts.length}}
  <ul class="space-y-3">
    {{#each this.posts as |post|}}
      <li data-test-post class="card">
        <div class="card-body flex items-center justify-between">
          <LinkTo @route="post" @model={{post.id}} class="font-medium hover:underline">
            {{post.title}}
          </LinkTo>
        </div>
      </li>
    {{/each}}
  </ul>
{{else}}
  <p class="text-sm muted" data-test-no-posts>No posts found</p>
{{/if}}
