{{page-title "Posts"}}

<div class="flex items-center justify-between mb-6">
  <h1 class="text-3xl font-bold tracking-tight">Posts</h1>
  <LinkTo @route="post-new" class="btn-primary">New Post</LinkTo>
</div>

<div class="mb-4 flex items-center justify-between">
  <input
    type="search"
    name="q"
    {{on "input" (perform this.searchTask)}}
    value={{this.q}}
    placeholder="Search posts…"
    aria-label="Search posts"
    class="input"
  />

  {{#if this.searchTask.isRunning}}
    <span class="ml-3 text-sm muted animate-pulse" role="status" aria-live="polite">
      Searching…
    </span>
  {{/if}}

  {{#if this.q}}
    <button
      {{on "click" (fn (perform this.searchTask) (hash target=(hash value="")))}}
      type="button"
      class="btn-secondary ml-2"
      data-test-clear-search
    >
      Clear
    </button>
  {{/if}}
</div>

<section aria-busy={{this.searchTask.isRunning}} class="posts-container">
  {{#if this.posts.length}}
    <ul class="space-y-3">
      {{#each this.posts as |post|}}
        <Post @post={{post}} />
      {{/each}}
    </ul>
  {{else}}
    <p class="text-sm muted" data-test-no-posts>No posts found</p>
  {{/if}}

  {{#if this.searchTask.last?.error}}
    <p class="text-red-600 text-sm mt-2">Search failed. Please try again.</p>
  {{/if}}
</section>